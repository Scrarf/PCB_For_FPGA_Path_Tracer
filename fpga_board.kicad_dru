(version 1)

(rule "Top width"
   (condition "A.NetClass == 'FIFO_DQ' && A.Layer == 'F.Cu'")
   (constraint track_width (min 0.185mm) (opt 0.19mm) (max 0.195mm))
)

(rule "In2 FIFO width"
   (condition "A.NetClass == 'FIFO_CTRL' && A.Layer == 'In2.Cu'")
   (constraint track_width (min 0.165mm) (opt 0.17mm) (max 0.175mm))
)

(rule "In4 FIFO width"
   (condition "A.NetClass == 'FIFO_CTRL' && A.Layer == 'In4.Cu'")
   (constraint track_width (min 0.165mm) (opt 0.17mm) (max 0.175mm))
)